{
  "expo": {
    "name": "customer-mobile",
    "slug": "customer-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/umunthuhub-logo.png",
    "scheme": "customermobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/umunthuhub-logo.png",
      "bundleIdentifier": "com.umunthuhub.customermobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ea580c",
        "foregroundImage": "./assets/images/umunthuhub-logo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.umunthuhub.customermobile"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ea580c",
          "image": "./assets/images/umunthuhub-logo.png",
          "imageWidth": 76
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
